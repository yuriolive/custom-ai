{
  "tasks": {
    "check": "deno check index.ts dimension.ts document.ts",
    "test": "deno test tests/",
    "lint": "deno lint",
    "fmt": "deno fmt --check"
  },
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": false,
    "lib": ["deno.window", "dom", "esnext"]
  },
  "lint": {
    "rules": {
      "tags": ["recommended"]
    }
  },
  "fmt": {
    "lineWidth": 96,
    "indentWidth": 2,
    "semiColons": true,
    "singleQuote": false
  },
  "imports": {}
}
