# =============================================================================
# custom-ai / inference marketplace — MVP-0 environment
# =============================================================================
# Copy to `.env.local` (Next.js) or `.env` and fill in.
# NOTHING in this file may contain a real credential — it is committed.
#
# Two rules, enforced by `npm run check:env` (also runs on `npm run build`):
#   1. A secret NEVER appears in a NEXT_PUBLIC_* variable. NEXT_PUBLIC_* is
#      inlined into the browser bundle at build time and is public forever.
#   2. Server-only variables are never referenced from a "use client" module.
#
# Never log an API key, an HF token, or a bearer header. (CONTRACTS.md)
# =============================================================================


# -----------------------------------------------------------------------------
# CLIENT-SAFE  (browser-visible, safe to inline)
# -----------------------------------------------------------------------------
# Contract names (CONTRACTS.md §Environment). Read these server-side.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=replace-with-anon-key

# Browser mirrors of the two client-safe values above. Next.js only exposes
# variables to client components when they carry the NEXT_PUBLIC_ prefix, so
# the same two values are duplicated here. The anon key is publishable by
# design — it is powerless without Row Level Security policies.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-anon-key


# -----------------------------------------------------------------------------
# SERVER-ONLY SECRETS  ***NEVER prefix any of these with NEXT_PUBLIC_***
# -----------------------------------------------------------------------------
# Supabase service role. Full bypass of RLS. Edge Functions only.
SUPABASE_SERVICE_ROLE_KEY=

# Upstream compute. The platform runs on MODAL; the RunPod pair is retained only
# for the second-provider path (NFR-EXT-001) and is unused today.
#
# UPSTREAM_PROVIDER selects the URL shape and auth scheme:
#   modal  -> {UPSTREAM_BASE_URL}/v1/chat/completions?<class-param query string>
#             authenticated with Modal-Key / Modal-Secret
#   runpod -> {UPSTREAM_BASE_URL}/v2/{id}/openai/v1/chat/completions
#             authenticated with Authorization: Bearer
#   mock   -> tools/mock-upstream, for tests and local work with no GPU spend
UPSTREAM_PROVIDER=mock

# Modal PROXY tokens (wk-… / ws-…). NOT the ak-/as- API token: an API token can
# deploy and DELETE apps, a proxy token can only invoke. Give the gateway the
# proxy pair. Mint with `modal workspace proxy-tokens create`.
# Server-side only — these must never appear in a NEXT_PUBLIC_* variable.
MODAL_KEY=
MODAL_SECRET=

# RunPod credentials (unused while UPSTREAM_PROVIDER=modal).
RUNPOD_API_KEY=
RUNPOD_ENDPOINT_ID=

# Platform key the /api/playground route handler presents to the gateway.
# MVP-0 placeholder: replaced by a session-scoped ephemeral key (FR-PLAY-001).
PLATFORM_API_KEY=

# Stripe — wallet top-up (PRD 4.4.4). Both are secrets.
#   STRIPE_SECRET_KEY     sk_test_... in dev, sk_live_... in production.
#   STRIPE_WEBHOOK_SECRET whsec_... — the HMAC key for Stripe-Signature. This is
#                         the ONLY thing separating a real Stripe callback from
#                         anyone on the internet POSTing "payment succeeded" at
#                         /api/stripe/webhook, so it is per-endpoint and must be
#                         re-read from the Stripe dashboard for each environment.
#                         Locally, `stripe listen --forward-to
#                         localhost:3000/api/stripe/webhook` prints its own.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=


# -----------------------------------------------------------------------------
# SERVER-ONLY, NON-SECRET  (configuration, not credentials)
# -----------------------------------------------------------------------------
# Absolute origin used to build Stripe Checkout's success/cancel URLs. Stripe
# rejects a relative URL. On Vercel this falls back to
# VERCEL_PROJECT_PRODUCTION_URL; set it explicitly for a custom domain.
SITE_URL=http://localhost:3000
# Pinned, usage-emitting llama.cpp worker build.
LLAMACPP_WORKER_IMAGE=

# Upstream override. Point at tools/mock-upstream in tests.
# Real:  https://api.runpod.ai
# Mock:  http://127.0.0.1:8787
UPSTREAM_BASE_URL=http://127.0.0.1:8787

# Base URL of the inference gateway (Supabase Edge Function). The playground
# route handler POSTs to `${GATEWAY_BASE_URL}/v1/chat/completions`.
GATEWAY_BASE_URL=http://127.0.0.1:54321/functions/v1/gateway

# Anthropic Messages API (`POST /v1/messages`), read by the EDGE FUNCTION only.
#
# Claude Code asks for `claude-*` model names that do not exist on this platform,
# so they have to be mapped onto `creator-handle/model-slug`. Keys are matched
# case-insensitively: first exactly, then as the longest substring of the
# requested name — one "haiku" entry therefore covers every dated haiku snapshot.
# A name that already contains a "/" is passed through untouched and never mapped.
# ANTHROPIC_MODEL_MAP={"claude-opus-4-6":"jonathancoletti/qwen3.8-27b-uncensored-gguf","haiku":"jonathancoletti/qwen3.8-27b-uncensored-gguf"}
ANTHROPIC_MODEL_MAP=
# Used when the requested name matches nothing above. Leave EMPTY to 404 instead:
# silently substituting a model bills the caller for inference they did not ask for.
ANTHROPIC_DEFAULT_MODEL=


# -----------------------------------------------------------------------------
# PLAYGROUND DEFAULTS  (client-safe, non-secret)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_DEFAULT_MODEL=JonathanColetti/Qwen3.8-27B-Uncensored-GGUF

# Honest cold-start estimate shown to the user while the GPU wakes, in seconds.
NEXT_PUBLIC_COLD_START_ESTIMATE_SECONDS=100
