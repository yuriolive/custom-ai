{
  "name": "custom-ai",
  "version": "0.1.0",
  "private": true,
  "description": "AI inference marketplace — MVP-0 monorepo root (Next.js 15 app + workspaces).",
  "engines": {
    "node": ">=22.18"
  },
  "workspaces": [
    "packages/*",
    "tools/*"
  ],
  "scripts": {
    "dev": "next dev",
    "build": "npm run check:env && npm run lint && next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "check:env": "node lib/scripts/check-env.mjs",
    "check": "npm run check:env && npm run lint && npm run typecheck"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "^3.0.31",
    "@ai-sdk/react": "^4.0.69",
    "@heroui/react": "^3.2.4",
    "@heroui/styles": "^3.2.4",
    "ai": "^7.0.66",
    "next": "15.5.23",
    "next-themes": "^0.4.6",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "server-only": "^0.0.1",
    "tailwind-variants": "^3.3.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@next/eslint-plugin-next": "15.5.23",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "eslint": "^9.39.1",
    "eslint-config-next": "15.5.23",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.48.1"
  }
}
