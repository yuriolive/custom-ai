{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "import"],
  "categories": {
    "correctness": "error",
    "suspicious": "error"
  },
  "env": {
    "es2024": true,
    "node": true,
    "browser": true
  },
  "ignorePatterns": [
    "node_modules/**",
    ".next/**",
    "out/**",
    "next-env.d.ts",
    "tools/runpod/**",
    "tools/modal/**",
    "supabase/migrations/**"
  ],
  "rules": {
    // Side-effect imports are load-bearing here: `./globals.css` is the Tailwind v4
    // entrypoint and `server-only` is the guard that keeps server modules off the client.
    "import/no-unassigned-import": ["error", { "allow": ["**/*.css", "server-only"] }],
    // The repo convention is a leading `_` for deliberately-unused/internal bindings
    // (see eslint.config.mjs argsIgnorePattern "^_"). This rule contradicts it.
    "no-underscore-dangle": "off"
  },
  "overrides": [
    {
      "files": ["supabase/functions/**/*.ts"],
      "globals": {
        "Deno": "readonly"
      }
    },
    {
      "files": ["**/test/**", "**/tests/**", "**/*.test.ts", "**/*_test.ts"],
      "rules": {
        // Test doubles are deliberately defined inside the case that uses them; hoisting
        // them to module scope would decouple a fixture from the assertion it exists for.
        "unicorn/consistent-function-scoping": "off",
        "no-empty-function": "off"
      }
    }
  ]
}
